# Copy this file to .env before running docker compose up.
# .env is gitignored; .env.example is not — never put real values here.

# Get a free key (no credit card required) at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy-your-key-here

# Shared secret the ASP.NET API presents to the Python AI service. Without it
# the AI service accepts any request that can reach its port.
SERVICE_TOKEN=change-me-to-a-long-random-string

# Encrypts stored third-party tokens (currently GitHub) before they touch the
# database. Any string works — it is SHA-256 hashed to a 32-byte AES key.
# Required outside Development; the API refuses to start without it.
#
# Generate one:
#   python  -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional: a checked-out repository the Dev Agent can answer about for every
# user. Per-user GitHub accounts are connected in the app instead.
# DEV_AGENT_REPO_HOST=../some-repo
